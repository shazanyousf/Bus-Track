# ────────────────────────────────────────────────────────────────────────────
# BUSTRACK UNIVERSITY - Backend Configuration
# ────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# For LOCAL DEVELOPMENT (uses local MongoDB):
# MONGODB_URI=mongodb://localhost:27017/bustrack_university
#
# For PRODUCTION (uses MongoDB Atlas cloud):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bustrack_university?retryWrites=true&w=majority

# ── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=bustrack_university_secret_2024
PORT=3000

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Use a sender address from a domain verified in Resend.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=onboarding@resend.dev

# For development: show reset codes in response for testing
SHOW_RESET_CODE=true

# ────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in your actual values
# ────────────────────────────────────────────────────────────────────────────
