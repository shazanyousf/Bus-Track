# ────────────────────────────────────────────────────────────────────────────
# BUSTRACK SCHOOL - Backend Configuration
# ────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# For LOCAL DEVELOPMENT (uses local MongoDB):
# MONGODB_URI=mongodb://localhost:27017/bustrack_school
#
# For PRODUCTION (uses MongoDB Atlas cloud):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/bustrack_school?retryWrites=true&w=majority

# ── Security ────────────────────────────────────────────────────────────────
JWT_SECRET=bustrack_school_secret_2024
PORT=3000

# ── Email (Brevo) ───────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-your_api_key
EMAIL_FROM=verified-sender@your-domain.com
SHOW_RESET_CODE=false

# ────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in your actual values
# ────────────────────────────────────────────────────────────────────────────
